---
import { site } from "@/config/site";
import SchemaOrg from "@/components/SchemaOrg.astro";

export interface Props {
  title: string;
  description?: string;
  canonical?: string;
  ogImage?: string;
  breadcrumbs?: { name: string; item?: string }[];
  faqs?: { q: string; a: string }[];
  match?: {
    teamA: string;
    teamB: string;
    date: string;
    venue: string;
    city: string;
    slug: string;
  };
}

const {
  title,
  description = site.description,
  canonical = Astro.url.href,
  ogImage = `${site.url}/og.png`,
  breadcrumbs,
  faqs,
  match,
} = Astro.props;

const fullTitle = title.includes(site.brand) ? title : `${title} | ${site.brand}`;
---

<!doctype html>
<html lang={site.lang}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <title>{fullTitle}</title>
    <meta name="description" content={description} />
    <link rel="canonical" href={canonical} />

    <!-- Open Graph / Bing Social -->
    <meta property="og:type" content="website" />
    <meta property="og:url" content={canonical} />
    <meta property="og:title" content={fullTitle} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:locale" content={site.locale} />

    <!-- Twitter/X card -->
    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={fullTitle} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <!-- Bing verification (add key after BWT setup) -->
    <!-- <meta name="msvalidate.01" content="REPLACE_BING_KEY" /> -->

    <!-- Favicon -->
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />

    <SchemaOrg breadcrumbs={breadcrumbs} faqs={faqs} match={match} />

    <style>
      *, *::before, *::after { box-sizing: border-box; margin: 0; padding: 0; }
      html { font-family: system-ui, -apple-system, sans-serif; font-size: 16px; color: #111; background: #fff; }
      body { max-width: 900px; margin: 0 auto; padding: 0 1rem 3rem; }
      a { color: #0057b7; }
      a:hover { color: #003d80; }
      header { padding: 1.25rem 0 1rem; border-bottom: 2px solid #e5e7eb; margin-bottom: 1.5rem; display: flex; align-items: center; justify-content: space-between; flex-wrap: wrap; gap: .5rem; }
      header .logo { font-size: 1.25rem; font-weight: 800; color: #111; text-decoration: none; }
      nav a { margin-left: 1rem; font-size: .9rem; text-decoration: none; color: #555; }
      nav a:hover { color: #0057b7; }
      h1 { font-size: 1.75rem; line-height: 1.25; margin-bottom: .75rem; }
      h2 { font-size: 1.25rem; margin: 1.5rem 0 .5rem; }
      h3 { font-size: 1.05rem; margin: 1.25rem 0 .4rem; }
      p { line-height: 1.65; margin-bottom: .75rem; }
      .cta { display: inline-block; background: #cc0000; color: #fff !important; padding: .6rem 1.4rem; border-radius: 6px; font-weight: 700; text-decoration: none; font-size: 1rem; margin: .5rem 0; }
      .cta:hover { background: #a00000; }
      .match-card { border: 1px solid #e5e7eb; border-radius: 8px; padding: 1rem; margin-bottom: 1rem; }
      .match-card .teams { font-size: 1.15rem; font-weight: 700; margin-bottom: .25rem; }
      .match-card .meta { font-size: .875rem; color: #555; }
      .tz-block { background: #f3f4f6; padding: .75rem 1rem; border-radius: 6px; font-size: .9rem; margin: .75rem 0; line-height: 1.8; }
      table { width: 100%; border-collapse: collapse; font-size: .9rem; margin: 1rem 0; }
      th { text-align: left; padding: .5rem .75rem; background: #f3f4f6; font-size: .8rem; text-transform: uppercase; letter-spacing: .04em; }
      td { padding: .5rem .75rem; border-top: 1px solid #e5e7eb; }
      footer { margin-top: 3rem; border-top: 1px solid #e5e7eb; padding-top: 1.5rem; font-size: .8rem; color: #777; }
      @media (max-width: 600px) { h1 { font-size: 1.35rem; } }
    </style>
  </head>
  <body>
    <header>
      <a class="logo" href="/">{site.brand}</a>
      <nav>
        <a href="/calendario">Calendario</a>
        <a href="/argentina">Argentina</a>
        <a href="/faq">FAQ</a>
      </nav>
    </header>

    <main>
      <slot />
    </main>

    <footer>
      <p>© 2026 {site.brand} · <a href={site.watchUrl} rel="nofollow noopener" target="_blank">{site.watchName}</a> · <a href="/faq">Preguntas frecuentes</a></p>
      <p style="margin-top:.5rem">Ver <a href="https://www.fifa.com" rel="nofollow noopener" target="_blank">información oficial FIFA</a>.</p>
    </footer>
  </body>
</html>
